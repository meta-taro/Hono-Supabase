{
  "name": "cake-shop-api",
  "version": "0.1.0",
  "description": "Hono × Supabase で作るケーキ屋注文API（学習サンプル）",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "tsx watch --env-file=.env app/index.node.ts",
    "build": "tsup app/index.node.ts --format esm --dts --out-dir dist --platform node",
    "start": "node --env-file=.env dist/index.node.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "wrangler:dev": "wrangler dev",
    "wrangler:deploy:staging": "wrangler deploy --env staging",
    "wrangler:deploy:production": "wrangler deploy --env production",
    "wrangler:secret:staging": "wrangler secret put --env staging",
    "wrangler:secret:production": "wrangler secret put --env production",
    "wrangler:tail:staging": "wrangler tail --env staging",
    "wrangler:tail:production": "wrangler tail --env production",
    "verify": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test:coverage",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,toml,html,css}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.18.4",
    "@supabase/supabase-js": "^2.105.4",
    "hono": "^4.12.19",
    "jose": "^6.2.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.8.43",
    "@cloudflare/workers-types": "^4.20260518.1",
    "@eslint/js": "^9.39.4",
    "@hono/node-server": "^1.19.14",
    "@types/node": "^22.19.19",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-istanbul": "^3.2.4",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.92.0"
  }
}
