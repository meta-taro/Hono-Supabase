# ============================================================
# Supabase 接続情報
# Supabase ダッシュボード → Project Settings → API で取得
# ローカル開発時は `supabase start` 実行後に表示される値を使う
# ============================================================

# Supabase プロジェクト URL
# ローカル例: http://localhost:54321
# 本番例:     https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=http://localhost:54321

# 匿名キー（公開可。RLS ポリシーで保護する）
SUPABASE_ANON_KEY=your_anon_key_here

# サービスロールキー（RLS をバイパスできる管理者キー。絶対に公開しない）
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================================
# アプリケーション設定
# ============================================================

# サーバーポート（デフォルト: 3000）
PORT=3000

# 実行環境: development | production | test
NODE_ENV=development

# ログ出力レベル: debug | info | warn | error
# 開発: debug / 本番: info
LOG_LEVEL=debug

# ============================================================
# Supabase Auth — Custom SMTP（Phase 8）
# ============================================================
# ※ 通常のローカル開発では **設定不要**。
# ローカルは Inbucket（http://127.0.0.1:54324）で送信メールを観察する方針に統一しています
# （理由: ホスト側 TLS インスペクション環境ではコンテナから外部 SMTP へ届かないため。
#  詳細は supabase/config.toml の `[auth.email.smtp]` ブロックのコメント参照）。
#
# 実 SMTP（Resend）の検証は **Supabase Cloud 側に直接設定**する方針です（Phase 8 Step 5）。
# その場合の API キーは **Supabase Cloud Dashboard の Authentication → SMTP Settings** に
# 直接入力します。ここ（アプリの .env / wrangler secret）には置きません — メール送信は
# Supabase Auth の責務であって、アプリ（Hono / Workers）は一切関わらないため。
#
# どうしてもローカルで実 SMTP を試したい場合（TLS インスペクション無し環境）のみ、
# supabase/config.toml の `[auth.email.smtp]` セクションをコメントアウト解除し、
# 下記の変数を有効化してください:
#
# SUPABASE_SMTP_PASS=re_your_resend_api_key_here
